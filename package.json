{
  "name": "software-distribution-platform-console",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:runcenter": "node scripts/runcenter-url-smoke.mjs",
    "clean": "bash scripts/clean.sh",
    "clean:deep": "bash scripts/clean.sh --deep",
    "package": "vite build",
    "image": "bash build/console/build.sh",
    "start:dev": "bash scripts/svc.sh start",
    "stop:dev": "bash scripts/svc.sh stop"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "oidc-client-ts": "^3.5.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.9"
  }
}
